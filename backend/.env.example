# Server
PORT=5001
NODE_ENV=development

# Local MongoDB. In production use MongoDB Atlas (mongodb+srv://...).
MONGODB_URI=MONGO_URI=mongodb+srv://siddharthsaswade23_db_user:jobportal123@cluster0.nqekahb.mongodb.net/atlas_prime

# Frontend origin(s) allowed by CORS, comma-separated. Must be explicit in production.
CORS_ORIGIN=http://localhost:5173
# Set to true on Vercel to also allow *.vercel.app preview deployments.
ALLOW_VERCEL_PREVIEWS=false

# Use a long random secret in production (32+ characters recommended).
JWT_SECRET=replace_with_a_long_random_string_before_deploying
JWT_EXPIRES_IN=7d

# OPTIONAL AI UPGRADE
# Leave OPENAI_API_KEY empty to use the free, built-in local matcher.
# When set, a single job match is scored by the model instead. Bulk ranking
# (recommendations / applicant ranking) always uses the local matcher.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
